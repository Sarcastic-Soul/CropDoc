{
  "expo": {
    "name": "CropDoc",
    "slug": "cropdoc",
    "owner": "sarcastic-soul",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6FEEB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.sarcasticsoul.cropdoc"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B7F4D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "react-native-fast-tflite",
      [
        "llama.rn",
        {
          "forceCxx20": false,
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CropDoc needs camera access to photograph crop leaves for disease detection."
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "CropDoc needs photo access to diagnose a leaf photo from your gallery."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b68c93c-d434-45f8-965c-2a89e8fb130d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/1b68c93c-d434-45f8-965c-2a89e8fb130d"
    }
  }
}
